[Unit]
Description=Vera authenticated agent report channel (synthetic only)
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=vera_ai
Group=bmasia-shared
UMask=0077
ExecStart=/usr/bin/python3 -I -B /opt/vera-hermes/deploy/agent-shadow/current/collector.py --config /opt/vera-hermes/deploy/agent-shadow/config.json
WorkingDirectory=/opt/vera-hermes/deploy/agent-shadow/current
RuntimeDirectory=bmasia-agent-shadow
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/opt/vera-hermes/data/runtime/agent-shadow-channel /run/bmasia-agent-shadow
MemoryMax=128M
TasksMax=8
CPUQuota=10%

[Install]
WantedBy=multi-user.target
