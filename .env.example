# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL use: postgresql://user:password@localhost:5432/bmasia_crm

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Soundtrack Your Brand API Credentials
# IMPORTANT: Keep these credentials secure and never commit them to version control
SOUNDTRACK_API_TOKEN=your-soundtrack-api-token-here
SOUNDTRACK_CLIENT_ID=your-soundtrack-client-id-here
SOUNDTRACK_CLIENT_SECRET=your-soundtrack-client-secret-here
# Rene Phase 2 read-only CRM credential (server stores no plaintext token)
RENE_RENEWAL_BOOK_TOKEN_SHA256=
RENE_RENEWAL_BOOK_TOKEN_EXPIRES_AT=
# Dedicated Rene Phase 2 MCP credential: store only the SHA-256 digest here.
# Never reuse or create a DRF Token for this secret.
CIRA_RENE_MCP_TOKEN_SHA256=
# Exact canonical active User UUID; either blank disables the dedicated endpoint
CIRA_RENE_MCP_USER_ID=
